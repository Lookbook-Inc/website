# Use fixture mode for ordinary local and preview development.
EDITS_DATA_MODE=fixture

# Production Lookbook Supabase project (never Style Snapshot).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Do not prefix with NEXT_PUBLIC_.
LOOKBOOK_BACKEND_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated production Supabase user IDs. Set enforcement to true during rollout.
EDITS_ENFORCE_ALLOWLIST=false
EDITS_ALLOWED_USER_IDS=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
